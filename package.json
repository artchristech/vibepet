{
  "name": "vibepet",
  "version": "0.3.0",
  "description": "desktop AI pet for vibe coders",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "test:render": "VIBEPET_RENDER_TEST=1 node test/content.test.js",
    "dist": "electron-builder --mac dmg zip --arm64 --x64"
  },
  "keywords": [],
  "author": "artchristech",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "productName": "vibepet",
  "homepage": "https://vibepet.net",
  "build": {
    "appId": "net.vibepet.app",
    "productName": "vibepet",
    "files": [
      "main.js",
      "place.js",
      "agents.js",
      "goal.js",
      "overrides.js",
      "content/**",
      "theater/**",
      "ports.js",
      "gesture.js",
      "preload.js",
      "renderer/**",
      "site/sprites.js",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.png",
      "extendInfo": {
        "LSUIElement": true
      },
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "dmg": {
      "title": "vibepet"
    },
    "artifactName": "vibepet-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "gsap": "^3.15.0"
  }
}
